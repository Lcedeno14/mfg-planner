# Microsoft SQL Server connection — copy this file to backend/.env and fill in.
# .env is gitignored; never commit real credentials.

MSSQL_SERVER=your-server.example.com
MSSQL_PORT=1433
MSSQL_DATABASE=Lineboard
MSSQL_USER=lineboard_app
MSSQL_PASSWORD=change-me

# Encryption is on by default (required for Azure SQL). For a local SQL Server
# with a self-signed certificate, keep encrypt on and set trust to true.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false

# API port (optional, defaults to 3000)
# PORT=3000
