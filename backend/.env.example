# Microsoft SQL Server connection.
#
#   cp .env.example .env      then fill in the values below
#
# .env is gitignored — real credentials must never be committed.
# These same settings are used by `npm start`, `npm run db:setup`,
# `npm run db:seed` and `npm run db:migrate`, so if one connects, all do.

# ── Required ────────────────────────────────────────────────────────────────
MSSQL_SERVER=your-server.example.com
MSSQL_DATABASE=Lineboard
MSSQL_USER=lineboard_app
MSSQL_PASSWORD=change-me

# ── Port OR named instance (not both) ───────────────────────────────────────
# Default port. Leave as-is for a standard install.
MSSQL_PORT=1433
#
# If your server uses a NAMED INSTANCE (e.g. SQLPROD01\SQLEXPRESS), set the
# instance here and COMMENT OUT MSSQL_PORT above — the SQL Browser service
# resolves the instance to its own port, and passing a port overrides it.
#   MSSQL_SERVER=SQLPROD01
#   MSSQL_INSTANCE=SQLEXPRESS

# ── Windows / Active Directory login ────────────────────────────────────────
# For a domain account, set the domain and use the bare username above
# (MSSQL_USER=jsmith, not DOMAIN\jsmith). Leave unset for a SQL login.
#   MSSQL_DOMAIN=CORP

# ── Encryption ──────────────────────────────────────────────────────────────
# On by default; required by Azure SQL. Set to false only if the server
# refuses TLS.
MSSQL_ENCRYPT=true
# Set to true when the server presents a self-signed or internal certificate,
# which is normal for on-prem SQL Server. Symptom if this is wrong:
# "self signed certificate" or a certificate-chain error on connect.
MSSQL_TRUST_SERVER_CERTIFICATE=false

# ── Optional tuning ─────────────────────────────────────────────────────────
# Milliseconds. Raise these on a slow VPN link.
# MSSQL_CONNECTION_TIMEOUT=15000
# MSSQL_REQUEST_TIMEOUT=15000

# API port (optional, defaults to 3000). The frontend dev server proxies
# /api to this port — see frontend/proxy.conf.json.
# PORT=3000
